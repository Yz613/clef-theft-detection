# Cloudflare Workers AI Configuration for @cf/cloudflare/clef
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_api_token
CLEF_MODEL=@cf/cloudflare/clef

# When set to true or when credentials are omitted, the service uses the
# calibrated local deterministic Clef decision engine.
USE_CLEF_SIMULATOR=false

PORT=3000
